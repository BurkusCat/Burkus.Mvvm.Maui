<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="DemoApp.Views.AutoSetPropertiesPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:burkus="http://burkus.co.uk"
    xmlns:vm="clr-namespace:DemoApp.ViewModels"
    Title="Auto Set Properties"
    x:DataType="vm:AutoSetPropertiesViewModel"
    BindingContext="{burkus:ResolveBindingContext x:TypeArguments=vm:AutoSetPropertiesViewModel}">
    <ScrollView>
        <VerticalStackLayout
            Margin="15"
            Spacing="10">
            <Label
                FontAttributes="Bold"
                HorizontalTextAlignment="Center"
                Text="These properties were set automatically from navigation parameters." />
            <Label
                FontSize="24"
                HorizontalTextAlignment="Center"
                IsVisible="{Binding IsHighlighted}"
                Style="{StaticResource HeadingLabel}"
                Text="{Binding GreetingText}" />
            <Label
                HorizontalTextAlignment="Center"
                Text="{Binding RepeatCount, StringFormat='Repeat count: {0}'}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
